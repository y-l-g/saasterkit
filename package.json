{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test:frontend": "node --test tests/Frontend/*.test.mts",
        "types:generate": "php artisan typescript:transform --no-interaction",
        "types:check": "npm run types:generate && vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@iconify-json/lucide": "^1.2.147",
        "@inertiajs/vite": "^3.9.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@unhead/bundler": "^3.4.3",
        "@vitejs/devtools-kit": "^0.7.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^10.0.6",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.3.5",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "@iconify-json/bi": "^1.2.7",
        "@inertiajs/vue3": "^3.9.1",
        "@nuxt/ui": "^4.12.0",
        "laravel-vite-plugin": "^3.2.0",
        "motion-v": "^2.8.0",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.44"
    },
    "overrides": {
        "esbuild": "^0.28.1"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.64.12",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    }
}
